{
  "manifest_version": 3,
  "name": "Side Shell · Zellij",
  "version": "0.1.0",
  "description": "Keep your local Zellij terminal visible while browsing. Read-only monitoring and interactive sessions powered by xterm.js.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Side Shell" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open Side Shell"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  }
}
