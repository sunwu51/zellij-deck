{
  "manifest_version": 3,
  "name": "wshell",
  "version": "0.1.0",
  "description": "Manage local Zellij sessions from a dashboard, with live previews and dedicated terminal windows.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open wshell dashboard" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open wshell dashboard"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
  }
}
