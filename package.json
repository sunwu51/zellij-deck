{
  "name": "zellij-deck",
  "version": "0.1.1",
  "description": "Local bridge for the Zellij Deck Chrome extension: manage, preview and attach to Zellij sessions from your browser.",
  "keywords": [
    "zellij",
    "terminal",
    "chrome-extension",
    "xterm",
    "mcp",
    "tmux",
    "session-manager"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunwu51/zellij-deck.git"
  },
  "homepage": "https://github.com/sunwu51/zellij-deck#readme",
  "bugs": {
    "url": "https://github.com/sunwu51/zellij-deck/issues"
  },
  "type": "module",
  "bin": {
    "zellij-deck": "bridge/cli.mjs"
  },
  "files": [
    "bridge",
    "scripts/prepare-pty.mjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bridge": "node bridge/cli.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs && node tests/mcp-integration.mjs",
    "icons": "node scripts/icons.mjs",
    "package:store": "node scripts/package-store.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.1.32",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3"
  }
}
